{
  "name": "TikTimer",
  "productName": "TikTimer",
  "version": "2.2.4",
  "author": "Сидуков Владислав Петрович",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.tiktimer.game",
    "files": [
      "main.js",
      "app.html",
      "package.json",
      "remote.html",
      "roulette.html",
      "timer.html",
      "uptime.html",
      "aplic/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true
  },
  "dependencies": {
    "socket.io-client": "^4.8.3",
    "tiktok-live-connector": "2.0.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^29.1.2",
    "electron-builder": "^24.9.1"
  }
}
